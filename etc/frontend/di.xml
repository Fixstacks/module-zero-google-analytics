<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Zero\GoogleAnalytics\Observer\Login" type="Zero\GoogleAnalytics\Observer\Account">
        <arguments>
            <argument name="eventName" xsi:type="string">login</argument>
        </arguments>
    </virtualType>
    <virtualType name="Zero\GoogleAnalytics\Observer\SignUp" type="Zero\GoogleAnalytics\Observer\Account">
        <arguments>
            <argument name="eventName" xsi:type="string">sign_up</argument>
        </arguments>
    </virtualType>
</config>
