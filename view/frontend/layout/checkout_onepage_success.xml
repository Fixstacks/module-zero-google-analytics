<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="before.body.end">
            <block name="zero.ga.page" template="Zero_GoogleAnalytics::page.phtml">
                <arguments>
                    <argument name="page_type" xsi:type="string">success</argument>
                    <argument name="tracker" xsi:type="object">Zero\GoogleAnalytics\ViewModel\Tracker</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
